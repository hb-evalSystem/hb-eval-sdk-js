# Save this file as `.gitignore` in the repository root.
#
# The leading dot matters, and Windows Explorer will not let you type it —
# create it from the command line instead:
#
#     cd hb-eval-sdk-js
#     copy gitignore.txt .gitignore
#
# WHY THESE TWO ENTRIES
#
# node_modules — thousands of files that npm rebuilds from package.json on any
# machine. Committing it makes the repository enormous and the history
# unreadable, and every install would fight the committed copy.
#
# dist — build output. It is regenerated by `npm run build`, and npm builds it
# again at publish time via the prepublishOnly script. Committing generated
# files lets the repository disagree with its own source, and the first symptom
# is a bug that exists only for people who cloned it.

node_modules/
dist/

# npm and editor noise
*.log
npm-debug.log*
.npm
.DS_Store
.vscode/
.idea/

# Local environment. Credentials must never reach the repository — an API key
# in git history stays there even after it is deleted from the working tree.
.env
.env.local
.env.*.local
